# Copy to .env.local and fill in. Git ignores .env.local.

# Vapi dashboard > API keys > Private API keys. Server only.
VAPI_PRIVATE_KEY=
# Vapi dashboard > Org settings > Organization ID. Not a secret.
VAPI_ORG_ID=
# Printed by `npm run vapi:sync`.
VAPI_ASSISTANT_ID=
# Printed by `npm run vapi:sync`. Laptop only: the AI actor.
VAPI_ACTOR_ID=

# Upstash console > the Redis database > REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A long random string you make up. Vapi sends it back on every webhook call.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in .env.local and in Vercel (Preview and Production).
VAPI_WEBHOOK_SECRET=

# Laptop only (`npm run dev`, never Vercel). SAMPLE_CALL_WEBHOOK_ORIGIN sends a
# laptop call's tool calls to the deployed site, so Luna can book (the AI
# actor's calls need it). SAMPLE_CALL_RECORDING=on records one call: only for
# the Sample Call (README, "Make the Sample Call"). Leave both unset otherwise.
# SAMPLE_CALL_RECORDING=on
# SAMPLE_CALL_WEBHOOK_ORIGIN=https://ai-voice-receptionist-tekguyz.vercel.app
